# ZYVORA Monorepo Environment Variables
# Copy to .env and fill in values
# Story: ZYV-16

# Frontend
VITE_API_URL=http://localhost:4000/api
VITE_FRONTEND_URL=http://localhost:5173

# Backend (also in apps/api/.env)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zyvora
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
# Lifetime of the JWT carried in the zyvora_session cookie (ZYV-32).
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-super-secret-cookie-key-min-32-chars
FRONTEND_URL=http://localhost:5173
# Comma-separated. Vite binds 127.0.0.1 while browsers open localhost — both
# spellings are required or the storefront's API calls are blocked.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse-proxy hops to trust when deriving the client IP. Default false.
#
# Leave false while the API is reachable directly. Express derives req.ip from
# the client-supplied X-Forwarded-For header when trust proxy is on, so any
# non-zero value lets a caller rotate that header to get a fresh rate-limit
# bucket per request — which defeats the limiter completely.
#
# Set it to the hop count ONLY when the edge proxy OVERWRITES X-Forwarded-For.
# A proxy that merely passes the client's header through makes any non-zero
# value unsafe.
TRUST_PROXY=false

# --- Validation (ZYV-28) -----------------------------------------------------
# The API validates all of the above at boot and refuses to start on a bad
# value, reporting every problem at once. In production it additionally
# requires JWT_SECRET and COOKIE_SECRET to be unique values of at least 32
# characters; shipping the development defaults would let anyone mint a valid
# session cookie.

# --- Development only ---------------------------------------------------------
# Returns live password-reset tokens in the forgot-password response, because no
# mailer is configured yet (ZYV-83). Off by default and REFUSED AT BOOT when
# NODE_ENV=production, because it would hand account takeover to anyone who can
# call the API. Never enable this on a real environment.
DEV_EXPOSE_RESET_TOKEN=false
