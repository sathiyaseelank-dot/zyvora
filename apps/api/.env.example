# ZYVORA API — environment template
# Copy to `.env` and fill in. Never commit the real `.env`.
# Story: ZYV-16

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string (ZYV-18 migration runner).
# DATABASE_URL=postgresql://zyvora:***@localhost:5432/zyvora

# Session signing secret. Must be >= 32 chars. REQUIRED in production —
# the API refuses to boot in production without it.
# Generate with: openssl rand -base64 48
# SESSION_SECRET=

# Browser origins allowed to call this API, comma separated.
# The Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# JWT & Cookie secrets (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
COOKIE_SECRET=your-super-secret-cookie-key-min-32-chars

# Razorpay — use TEST mode keys during development (ZYV-62, ZYV-63).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=
