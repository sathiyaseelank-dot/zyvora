{
  "name": "@zyvora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:make": "tsx -e \"import { FileMigrationProvider } from 'kysely/migration'; import * as fs from 'fs/promises'; import * as path from 'path'; const provider = new FileMigrationProvider({ fs, path, migrationFolder: path.join(import.meta.dirname, 'src/db/migrations') }); await provider.createMigration('migration_name');\"",
    "seed": "tsx src/db/seeds/seed.ts"
  },
  "dependencies": {
    "@zyvora/config": "*",
    "@zyvora/types": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.11.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
